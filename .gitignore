# Local libraries, harvested data, credentials, and generated packages stay on the developer's machine.
/library/
/data/
/backups/
/app/
/dist/
/build/
/.venv-client/
/.workbuddy/
/desktop/node_modules/
/desktop/dist/
/desktop/build/install-files.nsh

# Keep local test suites and Electron acceptance scripts out of the public repository.
/tests_client/
/test_*.py
/desktop/tests/
/desktop/electron/*-smoke.cjs
/desktop/electron/smoke.cjs
/docs/*
!/docs/使用指南.md
!/docs/开发指南.md

# Historical plans and local visual QA notes are retained locally only.
/design-qa.md
/desktop_client_plan.md
/partition_plan.md

__pycache__/
*.py[cod]
*.spec
*.log
*.tmp
*.bak
*.token
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.jsonl
*.jsonl.gz
*.pdf
*.docx
*.pptx
*.xlsx
*.exe
*.dll
.env*
!.env.example
*.pem
*.p12
*.key
