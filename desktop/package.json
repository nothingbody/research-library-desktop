{
  "name": "research-library-desktop",
  "version": "0.9.35",
  "private": true,
  "description": "Local-first research reference manager",
  "author": "Research Library",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package:dir": "electron-builder --dir",
    "package": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.13",
    "@xmldom/xmldom": "^0.8.15",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "local.research.library",
    "productName": "文献工作台",
    "protocols": [
      {
        "name": "文献工作台",
        "schemes": ["researchlibrary"]
      }
    ],
    "directories": {
      "output": "../dist/desktop"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/*-smoke.cjs",
      "!electron/smoke.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/backend/research-backend",
        "to": "backend"
      },
      {
        "from": "electron/browser-extension",
        "to": "browser-extension"
      },
      {
        "from": "electron/office-addin/word-manifest.xml",
        "to": "word-addin/word-manifest.xml"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "ResearchLibrary",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "artifactName": "ResearchLibrary-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ResearchLibrary-Portable-${version}-${arch}.${ext}"
    }
  }
}
