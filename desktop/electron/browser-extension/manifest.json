{
  "manifest_version": 3,
  "name": "文献工作台 · 浏览器采集",
  "version": "0.9.47",
  "key": "",
  "description": "将当前论文题录与可获取的 PDF 保存到本机文献库",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:28886/*",
    "https://*.cnki.net/*",
    "https://*.cnki.com.cn/*"
  ],
  "action": {
    "default_title": "保存到文献工作台",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
